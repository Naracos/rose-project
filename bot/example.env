# ============================================
# 🤖 CONFIGURATION DISCORD BOT
# ============================================
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_bot_client_id_here
GUILD_ID=your_guild_id_here

# ============================================
# 🗄️ BASE DE DONNÉES & API
# ============================================
MONGODB_URI=mongodb://localhost:27017/rose
API_URL=http://localhost:3000

# ============================================
# 📢 SALONS SYSTÈME
# ============================================
WELCOME_CHANNEL_ID=your_welcome_channel_id
ERROR_LOG_CHANNEL_ID=your_error_log_channel_id
ACTION_LOG_CHANNEL_ID=your_action_log_channel_id

# ============================================
# 📸 RGPD — DROIT À L'IMAGE
# ============================================
RGPD_MESSAGE_CHANNEL_ID=           # Salon où poster le message droit à l'image
RGPD_LOG_CHANNEL_ID=               # Salon de log (acceptations, révocations)
RGPD_MESSAGE_ID=                   # ID du message RGPD (à remplir après 1er envoi)

# ============================================
# 🎪 FORUMS SORTIES
# ============================================
SORTIES_PONCTUELLES_ID=your_sorties_ponctuelles_forum_id
SORTIES_RECURRENTES_ID=your_sorties_recurrentes_forum_id

# ============================================
# 👑 RÔLES ÉQUIPE (STAFF)
# ============================================
ROLE_ID_ADMIN1=                              # Clé Fonda
ROLE_ID_ADMIN2=                              # Clé Admin
ROLE_ID_FONDATEURS=                          # Fondateurs
ROLE_ID_CONSULTANTS=                         # Consultants
ROLE_ID_RESPONSABLES=                        # Responsables
ROLE_ID_MODERATEURS=                         # Médiation
ROLE_ID_WELCOMERS=                           # Welcomers
ROLE_ID_ANIMATEURS=                          # Animateur/ice
ROLE_ID_TECHNICIENS=                         # Techniciens
ROLE_ID_PHOTOS=                              # Vidéo / Photographe
ROLE_ID_CM=                                  # Community Manager
ROLE_ID_HELPERS=                             # Helpers

# ============================================
# 👥 RÔLES MEMBRES
# ============================================
ROLE_ID_VERIFIED=                            # Membre vérifié
ROLE_ID_MAN=                                 # Homme
ROLE_ID_WOMAN=                               # Femme
ROLE_ID_NEW=                                 # Nouveau membre

# ============================================
# 👑 Autres
# ============================================
HONEY_POT=
ROLE_ID_AUTOBAN=

# ============================================
# ⚙️ PARAMÈTRES OPTIONNELS
# ============================================
# COOLDOWN_PING_SECONDS=60                   # Cooldown pour ping participants (par défaut: 60s)
# MAX_PARTICIPANTS=50                        # Limite de participants par sortie
# DEBUG_MODE=false                           # Mode débogage (true/false)